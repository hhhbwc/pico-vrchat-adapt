# ============================================================
#  system.prop —— Magisk 开机早期自动注入的属性
#  这里只放“确定无害且广泛适用”的通用宽松项。
#  与 OS 版本相关的伪装逻辑放在 post-fs-data.sh（需要按当前值动态覆盖）。
# ============================================================

# 允许未知来源应用安装（部分 Pico ROM 用此开关）
ro.pico.unknownsource.allow=1

# 关闭严格签名校验（候选名，仅当系统读取此名时生效）
ro.pico.signature.strict=0
